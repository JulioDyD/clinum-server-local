#!/bin/bash
set -e

APP_USER="clinum"
APP_GROUP="clinum"
SUPPORT_USER="soporte"
ETCDIR="/etc/clinum-web-local"
VARDIR="/var/lib/clinum-web-local"
LOGDIR="/var/log/clinum-web-local"

# Usuario de sistema (sin login, sin home)
if ! getent passwd "$APP_USER" >/dev/null; then
  adduser --system --group --no-create-home --shell /usr/sbin/nologin "$APP_USER"
fi

# El usuario genérico de soporte (si existe en esta máquina) entra al grupo
# clinum para poder editar .env / colocar la credencial sin sudo por archivo.
if getent passwd "$SUPPORT_USER" >/dev/null; then
  adduser "$SUPPORT_USER" "$APP_GROUP" || true
fi

# Acceso al puerto serial (/dev/ttyUSB* , /dev/ttyACM*)
if getent group dialout >/dev/null; then
  adduser "$APP_USER" dialout || true
fi
if getent group plugdev >/dev/null; then
  adduser "$APP_USER" plugdev || true
fi

# Directorios de datos y logs
mkdir -p "$VARDIR" "$LOGDIR"
chown -R "$APP_USER":"$APP_GROUP" "$VARDIR" "$LOGDIR"
chmod 0755 "$VARDIR" "$LOGDIR"

# .env por defecto (conffile: no lo sobreescribe en upgrades)
# 0660: el grupo clinum (servicio + soporte) puede leer Y escribir, para que
# el panel (PATCH /integration-settings) y la edición manual por soporte
# funcionen sin tocar permisos a mano en cada sede.
if [ ! -f "$ETCDIR/.env" ]; then
  cp "$ETCDIR/.env.template" "$ETCDIR/.env"
  chown root:"$APP_GROUP" "$ETCDIR/.env"
  chmod 0660 "$ETCDIR/.env"
else
  # Instalación existente: corrige permisos de versiones anteriores (0640).
  chown root:"$APP_GROUP" "$ETCDIR/.env" || true
  chmod 0660 "$ETCDIR/.env" || true
fi

# Credencial de servicio (si ya existe en esta sede): mismo grupo, solo lectura.
if [ -f "$ETCDIR/service-account.json" ]; then
  chown root:"$APP_GROUP" "$ETCDIR/service-account.json" || true
  chmod 0640 "$ETCDIR/service-account.json" || true
fi

# Sedes instaladas antes de esta version no tienen GOOGLE_APPLICATION_CREDENTIALS
# en su .env (bug corregido): sin esa variable, el SDK de Firebase no encuentra
# la credencial aunque el archivo exista en disco, y el sync falla en silencio.
# La agregamos si falta, sin tocar el resto del .env del admin.
if [ -f "$ETCDIR/.env" ] && ! grep -q '^GOOGLE_APPLICATION_CREDENTIALS=' "$ETCDIR/.env"; then
  echo "GOOGLE_APPLICATION_CREDENTIALS=$ETCDIR/service-account.json" >> "$ETCDIR/.env"
fi

# systemd
systemctl daemon-reload >/dev/null 2>&1 || true
systemctl enable clinum-web-local >/dev/null 2>&1 || true

exit 0
