# Clinum local bridge - configuracion de produccion (solo local: serial + SQLite)
LOCAL_HTTP_PORT=8081
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=115200
LOCAL_DB_FILE=/var/lib/clinum-web-local/clinum.db
LOCAL_ONLY=1
# HTTPS with site-internal CA (method B). Server cert/key in /etc (never in git).
TLS_ENABLED=1
TLS_CERT_FILE=/etc/clinum-web-local/tls/server.crt
TLS_KEY_FILE=/etc/clinum-web-local/tls/server.key
# Plain-HTTP port that only redirects to HTTPS (0 = disabled).
TLS_REDIRECT_PORT=8080
# Origen(es) permitido(s) para Socket.IO. Separa varios con ; (ej: http://192.168.1.50:8081).
# Usa * para permitir cualquiera (red local de confianza).
CORS_ORIGIN=*
