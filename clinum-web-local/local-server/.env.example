LOCAL_HTTP_PORT=8081
SERIAL_PORT=COM6
SERIAL_BAUD=115200

# Path to Firebase service account json
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=clinum-2
# ID de la sede en el web (doc locations/{id}). Requerido para sincronizar
# devices/called/care_history con la sede correcta en clinum-web.
LOCATION_ID=

# Presencia: "aggregated" publica un solo doc por sede (site_presence/{LOCATION_ID})
# y evita escribir en cada heartbeat. "legacy" mantiene el comportamiento anterior.
PRESENCE_MODE=aggregated

# Historial: "local" hace que el puente escriba care_history (recomendado con
# HISTORY_WRITER local y la Cloud Function ignorando origin=local-bridge).
# "cloud" solo es válido si también se retira esa guarda en la Cloud Function.
HISTORY_WRITER=local

# Outbox durable local -> nube (recomendado). OUTBOX=0 vuelve al envío directo.
OUTBOX=1

# Pacientes: "web" bloquea la edición local y espeja Firestore (recomendado).
# "local" mantiene la edición local (útil solo en modo sin internet).
PATIENTS_SOURCE=web

# Escucha legacy de devices_config. La web ya usa site_sync; dejar en 0.
LEGACY_DEVICES_CONFIG=0

XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=qwen/qwen3.8-max:free
