# ── Secrets / entorno ───────────────────────────────────────────────
.env
.env.*
!.env.template
!.env.example
service-account.json
*-firebase-adminsdk-*.json
# Credenciales cifradas: solo .age se commitea
clinum-web-local/local-server/secrets/*.json
clinum-web-local/local-server/age.key
clinum-web-local/local-server/clinum-age.key
*.age.key
# La llave age se guarda en el repo por simplicidad (repo privado)
!clinum-web-local/local-server/secrets/age.key

# ── Bases de datos locales ─────────────────────────────────────────
*.db
*.db-wal
*.db-shm
data/

# ── Node.js ────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

